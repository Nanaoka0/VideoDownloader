<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoDownloader.ViewModels"
        x:Class="VideoDownloader.Views.VideoConversionView"
        x:DataType="vm:VideoConversionViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button Content="添加文件" Command="{Binding AddFilesCommand}" Height="34" Classes="Primary" />
    </StackPanel>
    <Border Grid.Row="1" Classes="Table">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="TableHeader">
<Grid ColumnDefinitions="Auto,*,96,96,96,124">
            <TextBlock Grid.Column="0" Text="选择" Classes="TableHeaderText" Margin="12,8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="文件名 / 进度" Classes="TableHeaderText" Margin="12,8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="容器" Classes="TableHeaderText" Margin="8,8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="编码" Classes="TableHeaderText" Margin="8,8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="编码器" Classes="TableHeaderText" Margin="8,8" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="操作" Classes="TableHeaderText" Margin="8,8" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VideoConversionItemViewModel">
                <Border Classes="TableRow">
<Grid ColumnDefinitions="Auto,*,96,96,96,124">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Task.IsSelected}" Margin="12,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,8">
                      <TextBlock Text="{Binding Task.FileName}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="500" FontSize="12" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding StatusDisplay}" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" Classes="StatusText" />
                        <TextBlock Text="{Binding ProgressDisplay}" Classes="StatusText" />
                      </StackPanel>
                      <ProgressBar Value="{Binding Task.Progress}" Height="6" Margin="0,6,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableContainers}" SelectedItem="{Binding SelectedContainer}" Margin="4" Height="28" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableVideoCodecs}" SelectedItem="{Binding SelectedVideoCodec}" Margin="4" Height="28" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableEncoders}" SelectedItem="{Binding SelectedEncoder}" Margin="4" Height="28" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <Button Content="停止" Command="{Binding StopCommand}" Classes="SmallButton" Width="48" Height="30" />
                      <Button Content="删除" Command="{Binding CancelCommand}" Classes="SmallButton Danger" Width="48" Height="30" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="转换选中项" Command="{Binding ConvertSelectedCommand}" Height="30" Classes="Primary" />
    </StackPanel>
  </Grid>
</UserControl>