<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VideoDownloader.Views.AboutView"
        Icon="/Assets/app_icon/app_icon.ico"
        Title="关于"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource BackgroundLight}">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- ===== Custom Title Bar ===== -->
    <Border Grid.Row="0" Classes="TitleBar" MinHeight="40"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,5,0">
        <TextBlock Grid.Column="0" Classes="TitleText" Text="关于" VerticalAlignment="Center" Margin="0,0,24,0" />
        <Button Grid.Column="2" Classes="WindowButton WindowButtonClose" Click="OnCloseClick"
                WindowDecorationProperties.ElementRole="User" Margin="0,5,0,0" VerticalAlignment="Top">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B00618" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
          </Button.Resources>
          <Panel Width="10" Height="10">
            <Line StartPoint="0,0" EndPoint="10,10" Stroke="{DynamicResource TextLight}" StrokeThickness="1.2" />
            <Line StartPoint="0,10" EndPoint="10,0" Stroke="{DynamicResource TextLight}" StrokeThickness="1.2" />
          </Panel>
        </Button>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="24,20" Spacing="10" VerticalAlignment="Center">
      <TextBlock Text="VideoDownloader" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextTheme}" HorizontalAlignment="Center" />
      <TextBlock Text="版本 Alpha-0.0.01" Classes="SecondaryText" HorizontalAlignment="Center" />
      <Separator Margin="0,4" Classes="CardDivider" />
      <TextBlock Text="基于 .NET 9 + Avalonia UI 构建的桌面视频下载与转码工具" Classes="SecondaryText" TextWrapping="Wrap" TextAlignment="Center" />
      <TextBlock Text="底层引擎: yt-dlp + ffmpeg" Classes="SecondaryText" HorizontalAlignment="Center" />
      <Separator Margin="0,4" Classes="CardDivider" />
      <TextBlock Text="© 2026 VideoDownloader" Classes="FaintText" HorizontalAlignment="Center" />
    </StackPanel>

    <Border Grid.Row="2" Classes="DialogFooter" Padding="12,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OkButton" Content="确定" Width="70" Height="30" Classes="Primary" />
      </StackPanel>
    </Border>
  </Grid>
</Window>