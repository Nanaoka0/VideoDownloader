<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoDownloader.ViewModels"
        x:Class="VideoDownloader.Views.DependencySettingsView"
        x:DataType="vm:DependencyViewModel">
  <Border Classes="Card" Padding="12,12,12,8">
    <StackPanel Spacing="10">
      <TextBlock Text="依赖检测" Classes="CardTitle" />
      <Separator Classes="CardDivider" />
      <StackPanel Spacing="12">
        <Button Content="检测依赖" Command="{Binding CheckDependenciesCommand}" Height="34" Classes="Primary" HorizontalAlignment="Left" />
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,80,160,Auto" ColumnSpacing="16" RowSpacing="12">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="ffmpeg" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Ffmpeg.IsAvailable, StringFormat='状态: {0}'}" Classes="SecondaryText" VerticalAlignment="Center" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Status.Ffmpeg.Version}" Classes="SecondaryText" VerticalAlignment="Center" />
          <Button Grid.Row="0" Grid.Column="3" Content="下载" Command="{Binding DownloadFfmpegCommand}" Height="28" Width="64" Classes="Secondary" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="ffprobe" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.Ffprobe.IsAvailable, StringFormat='状态: {0}'}" Classes="SecondaryText" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Status.Ffprobe.Version}" Classes="SecondaryText" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="yt-dlp" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.YtDlp.IsAvailable, StringFormat='状态: {0}'}" Classes="SecondaryText" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Status.YtDlp.Version}" Classes="SecondaryText" VerticalAlignment="Center" />
          <Button Grid.Row="2" Grid.Column="3" Content="下载" Command="{Binding DownloadYtDlpCommand}" Height="28" Width="64" Classes="Secondary" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>