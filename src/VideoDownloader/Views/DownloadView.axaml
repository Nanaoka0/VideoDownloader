<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoDownloader.ViewModels"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        x:Class="VideoDownloader.Views.DownloadView"
        x:DataType="vm:DownloadViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">

    <!-- 1. 上部设置与输入区 -->
    <Grid Grid.Row="0" ColumnDefinitions="1*,1*" ColumnSpacing="16">
      <!-- 左侧：输入区 -->
      <Border Grid.Column="0" Classes="Card">
        <Grid RowDefinitions="Auto,*">
          <Button Grid.Row="0" Content="添加任务" Command="{Binding AddUrlsCommand}"
                  Height="32" HorizontalAlignment="Left" Margin="0,0,0,8" Classes="Primary" />
          <TextBox Grid.Row="1" AcceptsReturn="True" MinHeight="100"
                   PlaceholderText="粘贴视频链接，每行一个..."
                   Text="{Binding UrlInput}" VerticalContentAlignment="Top" />
        </Grid>
      </Border>

      <!-- 右侧：输出配置区 -->
      <Border Grid.Column="1" Classes="Card">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
          <!-- 并行任务 + 完成后打开输出文件夹 -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="输出设置" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
              <Separator Width="1" Height="14" Margin="4,0" Opacity="0.3"/>
              <TextBlock Text="并行任务:" Classes="SecondaryText" VerticalAlignment="Center" />
              <ComboBox Width="70" Height="30" ItemsSource="{Binding MaxConcurrentOptions}" SelectedItem="{Binding MaxConcurrentDownloads}" FontSize="12" />
            </StackPanel>
            <Separator Grid.Column="1" Width="1" Height="20" Opacity="0.3" Margin="4,0" />
            <CheckBox Grid.Column="2" Content="完成后打开输出文件夹" IsChecked="{Binding OpenOutputFolder}" FontSize="11" Foreground="{DynamicResource TextDark}" VerticalAlignment="Center" />
          </Grid>

          <!-- 导出目录 -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="导出目录:" Classes="SecondaryText" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding OutputDirectory}" Height="32" Classes="SmallHeight" />
            <Button Grid.Column="2" Height="32" Classes="Secondary" Command="{Binding BrowseOutputDirectoryCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Image Source="{svg:SvgImage avares://VideoDownloader/Assets/ui_icon/folder.svg}" Width="14" Height="14" />
                <TextBlock Text="浏览" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- 操作按钮 -->
          <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Height="34" Classes="Danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DeleteAllCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <Image Source="{svg:SvgImage avares://VideoDownloader/Assets/ui_icon/delete.svg}" Width="16" Height="16" />
                <TextBlock Text="全部删除" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Height="34" Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding PauseAllTasksCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <Image Source="{svg:SvgImage avares://VideoDownloader/Assets/ui_icon/pause.svg}" Width="16" Height="16" />
                <TextBlock Text="暂停任务" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Height="34" Classes="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding StartAllDownloadsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <Image Source="{svg:SvgImage avares://VideoDownloader/Assets/ui_icon/download.svg}" Width="16" Height="16" />
                <TextBlock Text="开始下载" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- 2. 中部表格区 (自动撑满剩余高度) -->
    <Border Grid.Row="1" Classes="Table" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <!-- 表头 -->
        <Border Grid.Row="0" Classes="TableHeader">
          <Grid ColumnDefinitions="*,275,100" Margin="12,4">
            <TextBlock Grid.Column="0" Text="任务详情 / 进度" Classes="TableHeaderText" VerticalAlignment="Center" />
            <Button Grid.Column="0" Content="获取分辨率" Command="{Binding FetchAllResolutionsCommand}" Height="28" FontSize="11" Padding="8,0" Classes="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Grid.Column="1" Height="28" FontSize="11" ItemsSource="{Binding GlobalResolutionItems}" SelectedItem="{Binding GlobalResolution}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="8,0" />
            <CheckBox Grid.Column="2" Content="优先 HDR" IsChecked="{Binding PreferHdr}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
          </Grid>
        </Border>

        <!-- 列表内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadItemViewModel">
                <Border Classes="TableRow">
                  <Grid ColumnDefinitions="*,275,100" Margin="12,8">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="{Binding TaskTitle}" TextWrapping="NoWrap" FontWeight="500" FontSize="12" />
                      <TextBlock Text="{Binding Task.Url}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="10"
                                 Foreground="{DynamicResource TextDark}" ToolTip.Tip="{Binding Task.Url}" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding StatusDisplay}" Classes="StatusText" />
                        <TextBlock Text="{Binding ProgressDisplay}" Classes="StatusText" />
                        <TextBlock Text="{Binding SizeDisplay}" Classes="StatusText" />
                        <TextBlock Text="{Binding SpeedDisplay}" Classes="StatusText" />
                      </StackPanel>
                      <ProgressBar Value="{Binding Task.Progress}" Height="6" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 2. 清晰度选择器 -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}"
                              DisplayMemberBinding="{Binding DisplayName}" Height="28" FontSize="11" VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" Margin="8,0" PlaceholderText="单独设置分辨率" />

                    <!-- 3. 单项操作 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Classes="SmallButton" Width="30" Height="30" ToolTip.Tip="开始" Command="{Binding StartCommand}">
                        <Image Source="{svg:SvgImage avares://VideoDownloader/Assets/ui_icon/play.svg}" Width="14" Height="14" />
                      </Button>
                      <Button Classes="SmallButton" Width="30" Height="30" ToolTip.Tip="暂停" Command="{Binding PauseCommand}">
                        <Image Source="{svg:SvgImage avares://VideoDownloader/Assets/ui_icon/pause.svg}" Width="14" Height="14" />
                      </Button>
                      <Button Classes="SmallButton Danger" Width="30" Height="30" ToolTip.Tip="删除" Command="{Binding DeleteCommand}">
                        <Image Source="{svg:SvgImage avares://VideoDownloader/Assets/ui_icon/delete.svg}" Width="14" Height="14" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>