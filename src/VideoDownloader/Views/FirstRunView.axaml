<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VideoDownloader.Views.FirstRunView"
        Title="使用提示"
        Icon="/Assets/app_icon/app_icon.ico"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        MinHeight="120"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource BackgroundLight}">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- ===== Custom Title Bar ===== -->
    <Border Grid.Row="0" Classes="TitleBar" MinHeight="40"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,5,0">
        <TextBlock Grid.Column="0" Classes="TitleText" Text="使用提示" VerticalAlignment="Center" Margin="0,0,24,0" />
        <Button Grid.Column="2" Classes="WindowButton WindowButtonClose" Click="OnCloseClick"
                WindowDecorationProperties.ElementRole="User" Margin="0,5,0,0" VerticalAlignment="Top">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B00618" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
          </Button.Resources>
          <Panel Width="10" Height="10">
            <Line StartPoint="0,0" EndPoint="10,10" Stroke="{DynamicResource TextLight}" StrokeThickness="1.2" />
            <Line StartPoint="0,10" EndPoint="10,0" Stroke="{DynamicResource TextLight}" StrokeThickness="1.2" />
          </Panel>
        </Button>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="24,20,24,12" Spacing="14">
      <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextDark}" LineHeight="20">
          <Run Text="1、" FontWeight="Bold"/>
          <Run Text="先添加任务到列表，然后点击【获取分辨率】按钮，在下拉框中选择分辨率，才可以下载。" FontWeight="Normal"/>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextDark}" LineHeight="20">
          <Run Text="2、" FontWeight="Bold"/>
          <Run Text=" 左上角【设置】里，可以设置网络代理。" FontWeight="Normal"/>
        </TextBlock>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
        <CheckBox x:Name="AckCheckBox" Content="知道了" FontSize="13" Foreground="{DynamicResource TextTheme}" />
        <CheckBox x:Name="SuppressCheckBox" Content="启动时不再显示" FontSize="13" Foreground="{DynamicResource TextTheme}" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="2" Classes="DialogFooter" Padding="12,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="OkButton" Content="确定" Width="70" Height="30" Classes="Primary" />
      </StackPanel>
    </Border>
  </Grid>
</Window>