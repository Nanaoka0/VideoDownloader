<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VideoDownloader.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://VideoDownloader/Styles/AppStyles.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://VideoDownloader/Controls/TabButton.axaml" />
                <ResourceInclude Source="avares://VideoDownloader/Styles/Themes/Default.axaml" />
                <ResourceInclude Source="avares://VideoDownloader/Styles/Themes/Cyberpunk.axaml" />
                <ResourceInclude Source="avares://VideoDownloader/Styles/Themes/Neoclassical.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>