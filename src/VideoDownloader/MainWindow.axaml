<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VideoDownloader.ViewModels"
        xmlns:views="clr-namespace:VideoDownloader.Views"
        xmlns:rxui="using:ReactiveUI.Avalonia"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:controls="using:VideoDownloader.Controls"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="VideoDownloader.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app_icon/app_icon.ico"
        Title="VideoDownloader 0.1.0-alpha"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLight}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <Window.DataTemplates>
      <!-- 内容页宿主：按页面 VM 类型映射到对应视图 -->
      <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
        <views:DownloadView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:VideoConversionViewModel}">
        <views:VideoConversionView />
      </DataTemplate>
    </Window.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- ===== Custom Title Bar ===== -->
    <Border Grid.Row="0" Classes="TitleBar" MinHeight="40"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="10,0,5,0">
        <Image Grid.Column="0" Source="/Assets/app_icon/app_icon.ico" Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,8,0" />
        <TextBlock Grid.Column="1" Classes="TitleText" Text="VideoDownloader" VerticalAlignment="Center" Margin="0,0,24,0" />
        <Button Grid.Column="3" Classes="WindowButton" Click="OnMinimizeClick" Margin="8,5,2,0" VerticalAlignment="Top" WindowDecorationProperties.ElementRole="User">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
          </Button.Resources>
          <Panel Width="10" Height="10">
            <Line StartPoint="0,9" EndPoint="10,9" Stroke="White" StrokeThickness="1" />
          </Panel>
        </Button>
        <Button Grid.Column="4" Classes="WindowButton" Click="OnMaximizeClick" Margin="0,5,0,0" VerticalAlignment="Top" WindowDecorationProperties.ElementRole="User">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
          </Button.Resources>
          <Rectangle Width="10" Height="9" Stroke="White" StrokeThickness="1" />
        </Button>
        <Button Grid.Column="5" Classes="WindowButton WindowButtonClose" Click="OnCloseClick" Margin="2,5,0,0" VerticalAlignment="Top" WindowDecorationProperties.ElementRole="User">
          <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E81123" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B00618" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
          </Button.Resources>
          <Panel Width="10" Height="10">
            <Line StartPoint="0,0" EndPoint="10,10" Stroke="White" StrokeThickness="1.2" />
            <Line StartPoint="0,10" EndPoint="10,0" Stroke="White" StrokeThickness="1.2" />
          </Panel>
        </Button>
      </Grid>
    </Border>

    <!-- ===== Menu Bar ===== -->
    <Border Grid.Row="1" Classes="MenuBar" MinHeight="38">
      <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Spacing="4">
        <Button Content="设置" Click="OnSettingsClick" Classes="MenuItem" />
        <Button Content="关于" Click="OnAboutClick" Classes="MenuItem" />
      </StackPanel>
    </Border>

    <!-- ===== Tab Strip + Content Card (3-layer Z) ===== -->
    <Grid Grid.Row="2" Margin="0,8,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 底层：所有标签按钮，Z=1 -->
      <ItemsControl Grid.Column="1"
                    ZIndex="1"
                    VerticalAlignment="Top"
                    ItemsSource="{Binding Pages}"
                    IsHitTestVisible="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PageViewModel">
            <controls:TabButton Margin="0,11,4,0"
                                Header="{Binding Header}"
                                IsSelected="{Binding IsSelected}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectTabCommand}"
                                CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 内容区：Z=2（跨两列，覆盖 16px 对齐留白）；仅顶部一条分割线与标签连接，无卡片边框 -->
      <Border Grid.ColumnSpan="2"
              Margin="0,44,0,0"
              VerticalAlignment="Stretch"
              ZIndex="2"
Background="{DynamicResource BackgroundLight}"
              BorderBrush="{DynamicResource BorderLight}"
              BorderThickness="0,1,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12">
          <ContentControl Content="{Binding Selected.Content}" />
        </ScrollViewer>
      </Border>

      <!-- 顶层：全部标签按钮的镜像层，Z=3；非选中透明、选中不透明 → 选中浮层盖住卡片顶边线 -->
      <ItemsControl Grid.Column="1"
                    ZIndex="3"
                    VerticalAlignment="Top"
                    ItemsSource="{Binding Pages}"
                    IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="controls|TabButton">
            <Setter Property="Opacity" Value="0" />
          </Style>
          <Style Selector="controls|TabButton:selected">
            <Setter Property="Opacity" Value="1" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PageViewModel">
            <controls:TabButton Margin="0,11,4,0"
                                Header="{Binding Header}"
                                IsSelected="{Binding IsSelected}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- ===== Status Bar ===== -->
    <Border Grid.Row="4" Classes="StatusBar" MinHeight="32">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
        <Border Grid.Column="0" Classes="StatusProgress" Width="140" Height="16" Margin="0,0,12,0">
          <Border Background="{DynamicResource ButtonLight}" Width="{Binding GlobalProgress}" Height="14" HorizontalAlignment="Left" CornerRadius="3" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextDark}" />
        <Border Grid.Column="2" Classes="StatusProxy">
          <TextBlock Text="{Binding ProxyInfo}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextDark}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</rxui:ReactiveWindow>